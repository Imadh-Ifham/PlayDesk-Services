model LoungeService {
  loungeId   String   @map("lounge_id")                               // FK to lounges.id
  serviceId  String   @map("service_id")                              // FK to services.id
  enabled    Boolean  @default(true)                                  // Whether this service is enabled for the lounge

  // Relations
  lounge     Lounge   @relation(fields: [loungeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([loungeId, serviceId])                                         // Composite primary key
  @@map("lounge_services")                                            // Maps to SQL table `lounge_services`
}
