{
  "name": "services",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:merge": "npx prisma-merge -b prisma/base.prisma -s prisma/**/*.prisma -o prisma/schema.prisma -e prisma/schema.prisma",
    "prisma:generate": "pnpm prisma:merge && prisma generate",
    "seed": "ts-node src/seeds/index.ts",
    "seed:permissions": "ts-node src/seeds/permission.seed.ts",
    "seed:roles": "ts-node src/seeds/role.seed.ts",
    "seed:roles:test": "ts-node src/seeds/role.test.ts",
    "seed:all": "pnpm seed:permissions && pnpm seed:roles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.15",
    "nodemon": "^3.1.10",
    "prisma": "^6.12.0",
    "prisma-merge": "^0.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
